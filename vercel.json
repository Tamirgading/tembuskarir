{
  "framework": "nextjs",
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/crawl-seleksi",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 17 * * *"
    }
  ]
}
